# Todas as variáveis são opcionais para rodar localmente.
SECRET_KEY=YOUR_SECRET_KEY_HERE
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: se não definido, usa SQLite local (db.sqlite3)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Opcional: se não definidos, as fotos ficam na pasta local media/
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_API_KEY_HERE
# SUPABASE_BUCKET=media
